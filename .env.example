# Copy to .env if you need to change the base path.
#
# Base URL the app is served from. Keep "/" for Vercel/Netlify or local dev.
# For GitHub Pages use "/<repo-name>/".
VITE_BASE_PATH=/

# No API key goes here. The xAI key is entered by the visitor in the app's
# settings panel and stays in their browser (localStorage: asa.apiKey).
